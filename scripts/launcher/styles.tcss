Screen {
    layers: base;
}

#menu {
    width: 34;
    height: 1fr;
    border-right: solid $panel;
    padding: 1 0;
}

#detail {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#detail Label {
    margin-top: 1;
    color: $text-muted;
}

#detail Select {
    width: 32;
}

.summary {
    padding-bottom: 1;
    color: $text;
}

.warning {
    color: $warning;
    padding-bottom: 1;
}

.preview {
    margin-top: 1;
    padding: 1 2;
    background: $surface;
    color: $text-muted;
    border-left: thick $accent;
}

#run {
    margin-top: 1;
}
