# Reference only - secrets are managed via Infisical.
# Use ./run export-secrets [dev|staging|prod] to generate .env,
# or ./run dev / ./run prod which export automatically.
# If running without Infisical, copy to .env and fill in values manually.

# Shared
GUILD_ID=
DOMAIN=

# Role IDs (shared across bots)
STAFF_ROLE_ID=
SENIOR_STAFF_ROLE_ID=
OWNER_ROLE_ID=
MENTOR_ROLE_ID=

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=foundry

# PostgreSQL
POSTGRES_USER=foundry
POSTGRES_PASSWORD=
POSTGRES_DB=foundry
# Note: special chars in POSTGRES_PASSWORD must be percent-encoded (@ → %40, % → %25, etc.)

# Valkey / Redis
VALKEY_URI=redis://valkey:6379

# Discord bot tokens (each bot needs its own application/token)
DISCORD_SERVER_TOKEN=
DISCORD_UTILS_TOKEN=
DISCORD_EVENT_TOKEN=

# Music player bots (optional) - orchestrated by discord-utils.
# Comma-separated tokens, one per player bot, max 5. Each needs its own Discord
# application and only the Connect + Speak permissions. The number of tokens IS
# the pool size, so leaving this blank disables music entirely.
MUSIC_BOT_TOKENS=

# Lavalink audio node (required only when MUSIC_BOT_TOKENS is set).
# Any strong random string; must match on the node, in discord-utils, and in
# api-backend - which uses it for track search only, never for playback.
LAVALINK_PASSWORD=

# Spotify app credentials for LavaSrc. Spotify cannot be streamed by a bot, so
# these are metadata only - audio is mirrored from YouTube/SoundCloud by ISRC.
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Wise Old Man - RSN name change tracking (optional)
# Set WOM_GROUP_ID to enable; leave blank to disable the service
WOM_GROUP_ID=
WOM_GROUP_KEY=
WOM_API_KEY=
WOM_CLAN_NAME=Iron Foundry
WOM_DISCORD_CONTACT=

# Discord OAuth2 (for web-app login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.ironfoundry.cc/auth/callback

# Web app
FRONTEND_URL=https://ironfoundry.cc,http://localhost:3000
API_BACKEND_URL=https://api.ironfoundry.cc
# Dev only: overrides the API the local frontend talks to (defaults to http://localhost:8000)
BUN_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET=

# UploadThing - permanent image hosting for ticket transcripts (optional)
# Obtain from https://uploadthing.com/dashboard -> API Keys
# Leave blank to disable; Discord CDN links will be stored as-is (they expire)
UPLOADTHING_SECRET=

# Ironclad webhook integration (separate clan, not Iron Foundry)
IRONCLAD_WEBHOOK_URL=

# Party system - Discord webhook for party announcements (optional)
# Create a webhook in your party announcements channel and paste the full URL here.
# Leave blank to disable Discord integration for parties.
DISCORD_PARTY_WEBHOOK_URL=

# Metrics reporting - shared key used by all services that POST to /metrics/report.
# Set to any strong random string. Must be identical across api-backend and all reporting services.
METRICS_API_KEY=

# OSRS map (api-backend -> osrs-cache-service)
# Public base URL the browser reaches baked map tiles at. The /map/meta manifest's
# relative tileUrl is rewritten onto this. In production Traefik routes
# api.<domain>/map/* to the cache-tiles nginx sidecar; in dev the cache service is
# exposed on localhost:8100 with a FileResponse fallback. Leave blank for same-origin.
MAP_TILES_BASE_URL=

# OSRS Cache Service - dedicated Postgres for ingested game cache data
# (items, npcs, objects, varbits, sprites/icons) pulled from archive.openrs2.org
CACHE_POSTGRES_USER=osrs_cache
CACHE_POSTGRES_PASSWORD=
CACHE_POSTGRES_DB=osrs_cache
OPENRS2_BASE_URL=https://archive.openrs2.org
# How often to check OpenRS2 for a newer live OSRS cache build
CACHE_SYNC_INTERVAL_HOURS=0.5
# How long an on-demand item render (custom size, GET /item-icons/{id}/render) stays cached
RENDER_CACHE_TTL_DAYS=3

# Build provenance (optional, build-time only)
# Baked into the api-backend and osrs-cache-service images and reported by their
# GET /version endpoints. Set these when building a release image, e.g.
#   GIT_SHA=$(git rev-parse HEAD) BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) docker compose build
# Left blank, /version reports null for both.
GIT_SHA=
BUILD_TIME=
